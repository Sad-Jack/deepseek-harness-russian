{
  "name": "@local/dsh-locale-ru-021",
  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "description": "Russian language pack for DeepSeek Harness 0.2.1-rc.5, based on official DeepSeek translations.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "translations/*.json",
    "provenance.json",
    "verification.json",
    "UI-VERIFICATION.md",
    "LICENSE",
    "README*.md",
    "CHANGELOG.md",
    "REQUIREMENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "homepage": "https://github.com/Sad-Jack/deepseek-harness-russian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sad-Jack/deepseek-harness-russian.git"
  },
  "bugs": {
    "url": "https://github.com/Sad-Jack/deepseek-harness-russian/issues"
  },
  "author": {
    "name": "Sad-Jack",
    "url": "https://github.com/Sad-Jack"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "russian",
    "ru",
    "localization",
    "i18n",
    "language-pack"
  ],
  "engines": {
    "dsh": "0.2.1-rc.5"
  }
}
